[Unit]
Description=InField 7 website
After=network.target

[Service]
User=__USER__
WorkingDirectory=__ROOT__
Environment=NODE_ENV=production
EnvironmentFile=__ROOT__/.env.production
ExecStart=/bin/bash -lc 'exec /usr/bin/node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port "${PORT:-3002}"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
